{
  "name": "l-e-v-e-l-s",
  "compatibility_date": "2026-08-31",
  "main": "workers/bridge-worker.js",
  // Keeps the *.workers.dev URL enabled across redeploys — the Pages Function
  // at functions/api/live-dino.js calls it directly (same-zone self-fetches to
  // the apex domain get intercepted by the SPA instead of this Worker).
  "workers_dev": true,
  // Non-secret config so it survives redeploys (plain vars set only via the
  // dashboard get wiped on every Workers Builds deploy; RCON_PORT/PASSWORD
  // and PTERODACTYL_API_KEY stay as dashboard/CLI secrets since those are
  // meant to be sensitive).
  "vars": {
    "RCON_HOST": "208.115.234.226",
    // Bropanel (Game Host Bros) is Pterodactyl-based and exposes the standard
    // Client API for scripting file read/write over plain HTTPS — this is
    // the "external process with filesystem access" the mod's park/unpark
    // JSON files need, since the game server itself has no working HTTP
    // client (confirmed: curl.exe isn't installed and os.execute has no
    // other way to reach the internet).
    "PTERODACTYL_BASE_URL": "https://bropanel.gamehostbros.com",
    "PTERODACTYL_SERVER_ID": "db5c10f0"
  },
  // Aggregated parked-dino data synced from the game server's
  // Mods/LevelsPark/Saved/parked_<steamid>.json files on a cron schedule —
  // read by functions/api/parked-list.js.
  "kv_namespaces": [
    { "binding": "PARKED_KV", "id": "6cdde6c4833f48d9ace3f24c0a474120" }
  ],
  // Polls the game server's parked-state files every minute — Cloudflare's
  // tightest cron granularity — to keep the "just parked, why isn't it on
  // the website yet" gap as short as possible (see the `scheduled` handler
  // in bridge-worker.js; /sync-parked is also callable directly to force
  // an immediate sync without waiting for this).
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Scoped so the Worker only intercepts status requests, not the whole site (Pages must still serve "/")
  "routes": [
    { "pattern": "l-e-v-e-l-s.app/server-status", "zone_name": "l-e-v-e-l-s.app" },
    { "pattern": "l-e-v-e-l-s.app/status", "zone_name": "l-e-v-e-l-s.app" }
  ],
  // Real-time global chat — one shared ChatRoom instance for the whole
  // site (see bridge-worker.js), replacing the old KV-polling chat whose
  // multi-second write-propagation lag couldn't be fixed by polling
  // faster. Durable Object storage here is local to the instance, not
  // KV, so it doesn't share KV's account-wide read/write/list quotas.
  // The client connects straight to this Worker's own workers.dev
  // subdomain for /chat-ws (see script.js) rather than a l-e-v-e-l-s.app
  // route — confirmed live: the identical code completes the WebSocket
  // handshake perfectly on workers.dev but gets an abnormal 1006 closure
  // specifically via a zone route on this domain (a Cloudflare zone/route
  // quirk with Pages sharing the same zone, not a code bug — the zone's
  // own WebSockets setting is already confirmed on). No route needed
  // here for it as a result.
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_ROOM", "class_name": "ChatRoom" }
    ]
  },
  // Free-plan Durable Objects require SQLite-backed storage specifically
  // (new_sqlite_classes, not new_classes — confirmed live: "In order to
  // use Durable Objects with a free plan, you must create a namespace
  // using a new_sqlite_classes migration"). The classic get()/put()
  // storage API ChatRoom uses works the same on either backend.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }
  ]
}